# Backend Environment Configuration

# Database
DATABASE_URL=sqlite:///../database/quick_tym.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# JWT Authentication
JWT_SECRET_KEY=your-backend-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Configuration
API_PORT=8000
API_HOST=127.0.0.1
API_DOCS_ENABLED=true

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_FILE=../logs/backend.log

# AI Services
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_DEMAND_PREDICTION=true
WEATHER_API_KEY=your-openweather-api-key-here

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Email Configuration (for MVP, set to console)
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Session Management
SESSION_TIMEOUT_MINUTES=30
